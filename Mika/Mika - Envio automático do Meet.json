    {
      "parameters": {
        "jsCode": "// Processa todos os itens vindos do nó anterior\nreturn $input.all().map(item => {\n  const description = item.json.description || '';\n  \n  // 1. Remove tags HTML (ex: <p>, <br>)\n  const cleanHtml = description.replace(/<[^>]*>/g, ' ');\n  \n  // 2. Extrai apenas a sequência numérica\n  const digitsOnly = cleanHtml.replace(/\\D/g, '');\n  \n  // 3. Busca padrão de número brasileiro (com ou sem 55 no início)\n  const match = digitsOnly.match(/(?:55)?(\\d{10,11})/);\n  \n  let whatsappNumber = '';\n  if (match) {\n    const numberOnly = match[1];\n    whatsappNumber = '55' + numberOnly;\n  } else {\n    // Número padrão caso não encontre na descrição\n    whatsappNumber = '5511969085529';\n  }\n  \n  return {\n    json: {\n      ...item.json,\n      whatsappNumber: whatsappNumber\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
